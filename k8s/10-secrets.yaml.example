# Console secrets — copy and fill in real values before applying.
#
#   cp k8s/console/10-secrets.yaml.example k8s/console/10-secrets.yaml
#   # edit 10-secrets.yaml — replace every <...> placeholder
#   kubectl apply -f k8s/console/10-secrets.yaml
#
# 10-secrets.yaml is gitignored. Never commit the filled-in file.
---
# console-auth — next-auth session secret + operator password.
# CONSOLE_PASSWORD     : plain-text password the operator enters at login.
#                        Rotated via the /settings page (patches this Secret
#                        via the K8s API and reloads the session middleware).
# AUTH_SECRET          : random 32-byte base64 string for JWT signing.
#                        Generate with: openssl rand -base64 32
#                        This is the name Auth.js reads. A Secret carrying only
#                        the NEXTAUTH_-prefixed spelling leaves the pod refusing
#                        every request while src/instrumentation.ts logs
#                        `missing env vars: AUTH_SECRET`.
# CAMSIM_PASS          : password of the camera-sim mediamtx `camsim` user
#                        (HTTP basic auth on the :9997 API). Read it on the
#                        camera-sim VM: sudo sed -n 's/^CAMSIM_PASS=//p'
#                        /opt/camera-sim/.env. Without it the cameras page shows
#                        "mediamtx API credentials missing".
apiVersion: v1
kind: Secret
metadata:
  name: console-auth
  namespace: console
type: Opaque
stringData:
  CONSOLE_PASSWORD: "<change-me>"
  AUTH_SECRET: "<openssl rand -base64 32>"
  CAMSIM_PASS: "<camsim password from /opt/camera-sim/.env>"

---
# console-ssh — camera-sim SSH private key.
# Raw PEM of the ed25519 key authorized on the camera-sim EC2 instance.
# Mounted read-only at /etc/camera-sim/id_ed25519 inside the console pod.
#
# IMPORTANT: the PEM must include a trailing newline after the last line
# (-----END OPENSSH PRIVATE KEY-----\n). ssh2 / OpenSSH reject keys
# without it. Rotate via /secrets page; a nag banner appears after 90 days.
apiVersion: v1
kind: Secret
metadata:
  name: console-ssh
  namespace: console
type: Opaque
stringData:
  id_ed25519: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    <base64-encoded-key-body>
    -----END OPENSSH PRIVATE KEY-----
